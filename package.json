{
  "name": "minicode",
  "version": "0.1.0",
  "description": "一个从零实现的迷你 Claude Code：能调用工具的命令行编程助手",
  "type": "module",
  "bin": {
    "minicode": "./src/index.js",
    "minicode-core": "./src/core/daemon.js",
    "minicode-cli": "./src/clients/cli.js",
    "minicode-tui": "./src/clients/tui.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "core": "node src/core/daemon.js",
    "cli": "node src/clients/cli.js",
    "tui": "node src/clients/tui.js",
    "replay": "node src/clients/replay.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
