{
  "name": "minicode",
  "version": "0.1.0",
  "description": "一个从零实现的迷你 Claude Code：能调用工具的命令行编程助手",
  "type": "module",
  "bin": {
    "minicode": "./src/index.js",
    "minicode-core": "./src/core/daemon.js",
    "minicode-cli": "./src/clients/cli.js",
    "minicode-tui": "./src/clients/tui.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node src/index.js --provider ollama",
    "start:deepseek": "node src/index.js --provider deepseek",
    "core": "node src/core/daemon.js",
    "core:local": "node src/core/daemon.js --provider ollama",
    "core:deepseek": "node src/core/daemon.js --provider deepseek",
    "cli": "node src/clients/cli.js",
    "tui": "node src/clients/tui.js",
    "replay": "node src/clients/replay.js",
    "benchmark": "node benchmark/run.js --mode real --runs 3",
    "benchmark:mock": "node benchmark/run.js --mode mock --runs 1",
    "benchmark:quantify": "node benchmark/quantify.js --provider ollama --runs 10 --micro-runs 10",
    "benchmark:deepseek-ab": "node benchmark/deepseek-ab.js --provider deepseek --runs 5",
    "benchmark:prompt-injection": "node benchmark/prompt-injection.js --provider deepseek --runs 5",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
